# Compose Spark nạp file này sau khi copy thành scripts/.env và thay placeholders.
# Local Python không tự đọc .env; truyền environment trước khi gọi script.
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
OPENAI_API_KEY=replace-with-openai-key

# SPARK_MINIO_ENDPOINT có scheme, khác MINIO_ENDPOINT backend không có scheme.
SPARK_MINIO_ENDPOINT=http://minio:9000
HIVE_METASTORE_URI=thrift://hive-metastore:9083
SPARK_WAREHOUSE_PATH=s3a://warehouse/iceberg_data
SPARK_WEEKLY_WAREHOUSE_PATH=hdfs://dinhhoa-master:9000/user/ndh/warehouse
SPARK_CLUSTER_WAREHOUSE_PATH=hdfs://tuankiet170-master:9000/data_lake/warehouse
HDFS_HOST=dinhhoa-master
HDFS_PORT=9000
HDFS_USER=root
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
EMBEDDING_BATCH_SIZE=500
