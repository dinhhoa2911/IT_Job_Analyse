# Sao chép thành .env trên máy vận hành và thay placeholders; không commit .env.
ANTHROPIC_API_KEY=replace-with-anthropic-key
OPENAI_API_KEY=replace-with-openai-key
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key

# Mặc định không nhạy cảm trong Docker network hiện tại
ANTHROPIC_MODEL=claude-sonnet-4-6
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_COLLECTION=it_jobs_rag
TRINO_HOST=trino
TRINO_PORT=8080
TRINO_CATALOG=iceberg
TRINO_USER=chatbot
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MINIO_ENDPOINT=minio:9000
MINIO_CV_BUCKET=user-cvs
TOP_K_RESULTS=10
RETRIEVAL_K=30
RERANK_K=20
TRINO_METADATA_TIMEOUT=5
TRINO_QUERY_TIMEOUT=8
TRINO_FORECAST_TIMEOUT=10
TRINO_SKILL_GAP_TIMEOUT=15
TRINO_LEARNING_TIMEOUT=20
